NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Web server only: copy these public IDs to web/.env.local.
# Deployment receipts are in docs/testnet-deployment.md; the UI still verifies RPC state before enabling controls.
# The web RPC/network are fixed to NEAR testnet. Never add private keys to web env.
CARECART_VAULT_ID=vault.carecart.testnet
CARECART_TEST_TOKEN_ID=token.carecart.testnet
CARECART_ADMIN_ID=admin.carecart.testnet
# Server-only backend URL for the web procurement proxy.
CARECART_API_URL=http://127.0.0.1:3001
# Backend IDs below stay unset until deployment and restricted-key configuration are complete.
VAULT_ID=
TEST_TOKEN_ID=
VAULT_ASSET_CODE=CCTEST
# Server-only function-call key restricted to commit_purchase_order on VAULT_ID.
# The human admin funds fund_commit_storage first; backend calls attach zero deposit.
PO_COMMITTER_ACCOUNT_ID=
PO_COMMITTER_PRIVATE_KEY=
# Server-only function-call key scoped on chain to request_payment.
AGENT_ACCOUNT_ID=
AGENT_FC_PRIVATE_KEY=
# Server-only provider values; default judge flow stays deterministic.
# Opt-in manual adapter setup and pending live compatibility: docs/testnet-gap-implementation.md.
OPENAI_BASE_URL=https://cloud-api.near.ai/v1
# Live private-inference adapter uses this provider-specific credential only.
NEAR_CLOUD_API_KEY=
NEAR_CLOUD_BASE_URL=https://cloud-api.near.ai/v1
NEAR_CLOUD_MODEL=z-ai/glm-5.3-flash
# Retained legacy key; it is not sent to NEAR Cloud and does not enable an OpenAI provider.
OPENAI_API_KEY=
OPENAI_MODEL=
# Explicit manual live AI mode; legacy /api/agent/tasks remains deterministic.
CARECART_AI_MODE=deterministic
# Server-only bearer token (at least 32 characters) for /api/agent/tick; never copy to web.
CARECART_OPERATOR_TOKEN=
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
# Optional MAINNET market-data preview only; never enables settlement or changes the testnet wallet network.
# Keep disabled until the human reviews a separate route, amount, recipient and refund address.
# Asset IDs must match the live GET /v0/tokens list exactly; never construct IDs from token symbols.
ONECLICK_PREVIEW_ENABLED=false
ONECLICK_PREVIEW_ORIGIN_ASSET_ID=
ONECLICK_PREVIEW_DESTINATION_ASSET_ID=
ONECLICK_PREVIEW_AMOUNT_ATOMIC=
ONECLICK_PREVIEW_RECIPIENT=
ONECLICK_PREVIEW_REFUND_TO=
# Separate operational settlement CLI only; these never enable the browser preview or wallet mainnet.
# Do not configure writes until exact profile/transaction approval. See mainnet-todo.md gates.
ONECLICK_SETTLEMENT_API_KEY=
CARECART_SAFETY_WRITES=disabled
SAFETY_COMMITTER_PRIVATE_KEY=
SAFETY_REQUESTER_PRIVATE_KEY=
SAFETY_REFUND_SIGNERS_JSON=
