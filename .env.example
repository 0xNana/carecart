# ============================================================================
# CareCart Consolidated Environment (.env.example)
# Copy to .env (and symlink web/.env.local -> ../.env).
# ============================================================================

# 1. Identity & Origins (Supabase + Next.js + Tenant API)
CARECART_AUTH_MODE=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
# Production web and backend: https://app.carecart.xyz (website: carecart.xyz; documentation: docs.carecart.xyz).
CARECART_PUBLIC_ORIGIN=http://127.0.0.1:3000
CARECART_OPERATIONS_API_URL=http://127.0.0.1:3002
CARECART_OPERATIONS_PORT=3002
NEXT_TELEMETRY_DISABLED=1

# 2. NEAR Testnet Wallet Binding & Active Profiles
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
CARECART_WALLET_BINDING_ENABLED=true
CARECART_WALLET_BINDING_NETWORK=testnet
CARECART_WALLET_BINDING_RPC_URL=https://test.rpc.fastnear.com
CARECART_TESTNET_WORKSPACE_FILE=../profiles/testnet.demo.json
CARECART_TESTNET_PAYMENTS_FILE=../profiles/testnet.payments.json
CARECART_INVENTORY_WORKER_ENABLED=true

# 3. Live AI (NEAR AI Cloud)
CARECART_AI_MODE=near-ai-cloud
NEAR_CLOUD_API_KEY=
NEAR_CLOUD_BASE_URL=https://cloud-api.near.ai/v1
NEAR_CLOUD_MODEL=z-ai/glm-5.3-flash

# 4. Testnet Payment Workers (Restricted v2 Function-Call Keys)
CARECART_TENANT_FINANCIAL_MODE=near-testnet
CARECART_SAFETY_WRITES=approved
# Do not put signing keys in this shared file. API, inventory worker, and web processes load it.
# Provide exactly one SAFETY_*_PRIVATE_KEY through a protected, role-specific signer service environment.

# 5. Local / Standalone Operations Fallback
CARECART_OPERATIONS_OPERATOR_SECRET=
CARECART_OPERATIONS_MODE=local-synthetic
CARECART_OPERATIONS_WORKSPACE=workspace
CARECART_INVENTORY_DATASET=clinic
CARECART_INVENTORY_WORKSPACE=clinic-runtime

# 6. 1Click Cross-Chain Preview (Optional)
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_PREVIEW_ENABLED=false
ONECLICK_PREVIEW_ORIGIN_ASSET_ID=
ONECLICK_PREVIEW_DESTINATION_ASSET_ID=
ONECLICK_PREVIEW_AMOUNT_ATOMIC=
ONECLICK_PREVIEW_RECIPIENT=
ONECLICK_PREVIEW_REFUND_TO=
ONECLICK_SETTLEMENT_API_KEY=
SAFETY_REFUND_SIGNERS_JSON=
