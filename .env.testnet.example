# Local offline testnet preparation only; no keys, funding or public RPC calls.
CARECART_OPERATIONS_MODE=testnet-preparation
CARECART_TESTNET_WORKSPACE_FILE=../profiles/testnet.demo.json
CARECART_INVENTORY_DATASET=clinic
CARECART_INVENTORY_WORKER_ENABLED=true
CARECART_OPERATIONS_ORIGIN=http://127.0.0.1:3005
CARECART_OPERATIONS_PORT=3004
CARECART_OPERATIONS_API_URL=http://127.0.0.1:3004
# For the isolated local demo only. Set a private random value of at least 32 characters.
CARECART_OPERATIONS_OPERATOR_SECRET=REPLACE_WITH_PRIVATE_RANDOM_LOCAL_OPERATOR_VALUE
CARECART_AUTH_MODE=legacy-local
NEXT_TELEMETRY_DISABLED=1
# This file does not activate Supabase tenants or public financial execution.
