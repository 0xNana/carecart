# Local: loopback HTTP. Hosted: exact approved HTTPS origin, no trailing slash.
# Keep server-side keys, paths and this file outside public/static directories.
# Copy into an owner-managed identity-only environment. Never source the legacy
# wallet/payment environment into these processes. Values below are placeholders.
CARECART_AUTH_MODE=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
CARECART_PUBLIC_ORIGIN=http://127.0.0.1:3000
CARECART_OPERATIONS_API_URL=http://127.0.0.1:3002
CARECART_OPERATIONS_PORT=3002
# Only the separate worker process needs this. Per-clinic monitoring also starts off.
CARECART_INVENTORY_WORKER_ENABLED=false
# Explicit key-free testnet preparation. No RPC/signing/payment activation.
CARECART_TESTNET_WORKSPACE_FILE=../profiles/testnet.demo.json
# A separately reviewed CARECART_TESTNET_PAYMENTS_FILE may enable scoped reads/authorizations
# for its exact clinic. Never selects a mainnet profile or enables a signer by default.
# Optional OFF-CHAIN wallet ownership proof only. Never enables financial execution.
CARECART_WALLET_BINDING_ENABLED=false
CARECART_WALLET_BINDING_NETWORK=testnet
CARECART_WALLET_BINDING_RPC_URL=https://test.rpc.fastnear.com
# Do not add service-role/secret keys, JWT signing secrets, wallet keys,
# CARECART_SAFETY_WRITES=approved, or financial worker activation here.
