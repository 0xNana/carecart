import {test} from 'node:test';import assert from 'node:assert/strict';import {connectOwnershipWallet} from '../src/lib/wallet-binding.ts';
test('Wallet proof rejects unsupported wallets and wrong network without transaction fallback',async()=>{for(const bad of ['network','capability']){let disconnected=false;await assert.rejects(connectOwnershipWallet(async()=>({network:bad==='network'?'mainnet':'testnet',wallet:{manifest:{features:{testnet:true,signMessage:bad!=='capability'}},getAccounts:async()=>[{accountId:'owner.testnet'}],signMessage:async()=>{throw Error('must not sign');}},disconnect:async()=>{disconnected=true;}})));assert.equal(disconnected,true);}});
test('Wallet proof uses only NEP413 message API, exact account and explicit testnet',async()=>{let calls=0;const c=await connectOwnershipWallet(async()=>({network:'testnet',wallet:{manifest:{features:{testnet:true,signMessage:true}},getAccounts:async()=>[{accountId:'owner.testnet'}],signMessage:async p=>{calls++;assert.equal(p.network,'testnet');assert.equal(p.signerId,'owner.testnet');assert.equal(p.nonce.length,32);return {accountId:p.signerId,publicKey:'fixture',signature:'fixture'};}},disconnect:async()=>{}}));await assert.rejects(c.prove({accountId:'foreign.testnet',network:'testnet',payload:{message:'x',recipient:'carecart',nonce:btoa('a'.repeat(32))}}));await c.prove({accountId:'owner.testnet',network:'testnet',payload:{message:'x',recipient:'carecart',nonce:btoa('a'.repeat(32))}});assert.equal(calls,1);});
test('CLI proof import accepts only public proof fields for the exact outstanding challenge',async()=>{
 const {parseOwnershipProof}=await import('../src/lib/wallet-binding.ts');const challenge={id:'a',accountId:'admin.carecart.testnet'};const proof={challengeId:'a',accountId:challenge.accountId,publicKey:'ed25519:'+'1'.repeat(32),signature:'a'.repeat(86)+'=='};
 assert.equal(parseOwnershipProof(JSON.stringify(proof),challenge).accountId,challenge.accountId);
 for(const change of [{accountId:'other.testnet'},{challengeId:'b'},{privateKey:'never-accept'},{publicKey:'ed25519:'+'1'.repeat(88)},{signature:'bad'}])assert.throws(()=>parseOwnershipProof(JSON.stringify({...proof,...change}),challenge));
});
