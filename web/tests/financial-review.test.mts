import {test} from 'node:test';import assert from 'node:assert/strict';
import {parseFinancialReview,type FinancialReview} from '../src/lib/financial-review.ts';import {jsonHash} from '../src/lib/v2-wallet.ts';
const fingerprint='a'.repeat(64);
async function fixture():Promise<FinancialReview>{const canonical={po_id:'mn-po-'+ '1'.repeat(56),profile:'mainnet',supplier:'supplier-a.local-ops.near',token:'native-usdc.near',amount:'1500000',invoice_digest:'b'.repeat(64),destination:'Near' as const};return {
 profileFingerprint:fingerprint,caseId:'case-1',revision:5,state:'PoDrafted',nextAction:'AuthorizeCommitment',canonical,canonicalHash:await jsonHash(canonical),quote:{id:'quote-1',supplierId:'supplier-1',supplierAccount:canonical.supplier,quantity:30,unitPriceAtomic:'50000',amountAtomic:canonical.amount,issuedAt:new Date().toISOString(),expiresAt:new Date(Date.now()+3600000).toISOString(),asset:'USDC',decimals:6},quoteExpired:false,
 policy:{limits:{auto_per_po_limit:'10000000',hard_payout_limit:'25000000',daily_dispatch_limit:'25000000',accepted_deposit_ceiling:'5000000'},spendable:null,usage:null,blocks:['FinancialExecutionDisabled'],observed:false,humanRequired:false,supplierApproved:null},requiredAuthority:'committer',approvalStatus:'Unobserved',operations:[],settlement:null,execution:'disabled',publicSigningEnabled:false,authorizations:[]};}
test('FINANCIAL REVIEW: exact PO/hash, six-decimal math and disabled mainnet are explicit',async()=>{const r=await fixture();assert.equal((await parseFinancialReview(r,fingerprint)).policy.spendable,null);await assert.rejects(parseFinancialReview({...r,publicSigningEnabled:true},fingerprint));await assert.rejects(parseFinancialReview({...r,canonical:{...r.canonical,amount:'1'}},fingerprint));await assert.rejects(parseFinancialReview(r,'c'.repeat(64)));});
test('FINANCIAL REVIEW: recipient, unit price, policy cap and environment claims cannot be substituted',async()=>{const r=await fixture();for(const corrupt of [{...r,quote:{...r.quote,supplierAccount:'attacker.near'}},{...r,quote:{...r.quote,unitPriceAtomic:'1'}},{...r,policy:{...r.policy,limits:{...r.policy.limits,hard_payout_limit:'26000000'}}},{...r,execution:'sandbox-rpc'}])await assert.rejects(parseFinancialReview(corrupt,fingerprint));});
test('FINANCIAL REVIEW: public activation is testnet-only, with explicit CCUSD and a matching public-signing flag',async()=>{
 const r=await fixture();const canonical={...r.canonical,profile:'testnet',token:'token-v2.carecart.testnet',supplier:'medsupply-a.carecart.testnet'};
 const live={...r,canonical,canonicalHash:await jsonHash(canonical),quote:{...r.quote,asset:'CCUSD',supplierAccount:canonical.supplier},execution:'public-rpc',publicSigningEnabled:true};
 assert.equal((await parseFinancialReview(live,fingerprint)).execution,'public-rpc');
 for(const bad of [{...live,publicSigningEnabled:false},{...live,quote:{...live.quote,asset:'USDC'}},{...live,canonical:{...canonical,profile:'mainnet'},canonicalHash:await jsonHash({...canonical,profile:'mainnet'})}])await assert.rejects(parseFinancialReview(bad,fingerprint));
});
