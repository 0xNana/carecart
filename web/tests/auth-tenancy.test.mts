import {test} from 'node:test';import assert from 'node:assert/strict';import {authConfiguration,safeAuthNext,supabaseMode} from '../src/lib/auth-config.ts';import {OperatorClient} from '../src/lib/operator-client.ts';
test('AUTH REDIRECTS: only explicit application/onboarding/recovery paths are accepted',()=>{for(const value of ['https://evil.example','//evil.example','/\\evil.example','/%2f%2fevil.example','/app?next=https://evil.example','/auth/callback','javascript:alert(1)'])assert.equal(safeAuthNext(value),'/onboarding');for(const path of ['/app','/app/inventory','/reset-password','/onboarding?invite='+'a'.repeat(64)])assert.equal(safeAuthNext(path),path);});
test('AUTH CONFIGURATION: explicit profile, HTTPS provider, canonical origin and publishable key fail closed',()=>{assert.equal(supabaseMode({}),false);assert.throws(()=>supabaseMode({CARECART_AUTH_MODE:'unknown'}));assert.throws(()=>authConfiguration({CARECART_AUTH_MODE:'supabase'}));const config={CARECART_AUTH_MODE:'supabase',SUPABASE_URL:'https://project.supabase.co',SUPABASE_PUBLISHABLE_KEY:'sb_publishable_fixture_only',CARECART_PUBLIC_ORIGIN:'https://carecart.example'};assert.equal(authConfiguration(config).secure,true);assert.throws(()=>authConfiguration({...config,SUPABASE_PUBLISHABLE_KEY:'sb_secret_rejected_fixture'}));assert.throws(()=>authConfiguration({...config,CARECART_PUBLIC_ORIGIN:'https://carecart.example/path'}));});
test('CLINIC CACHE: responses from a changed clinic are rejected before use and client state is cleared',async()=>{const client=new OperatorClient(async()=>Response.json({items:[{id:'foreign'}]},{headers:{'x-carecart-clinic':'other-clinic'}}),'expected-clinic');await assert.rejects(client.inventory(),/CLINIC_CONTEXT_CHANGED/);assert.equal(client.authenticated,false);const local=new OperatorClient(async()=>Response.json({items:[]},{headers:{'x-carecart-clinic':'expected-clinic'}}),'expected-clinic');assert.deepEqual(await local.inventory(),[]);});

test('retired Playground login destinations normalize to the authenticated app',()=>{for(const path of ['/app/playground','/app/playground/testnet'])assert.equal(safeAuthNext(path),'/app');assert.equal(safeAuthNext('/app/playground/unknown'),'/onboarding');});
